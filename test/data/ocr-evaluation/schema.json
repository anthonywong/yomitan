{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "license", "textNormalization", "provenance", "fixtures"],
    "properties": {
        "schemaVersion": {"const": 1},
        "license": {"const": "CC0-1.0"},
        "textNormalization": {"const": "NFC"},
        "provenance": {"$ref": "#/$defs/generatedProvenance"},
        "fixtures": {
            "type": "array",
            "minItems": 1,
            "items": {"oneOf": [{"$ref": "#/$defs/readyFixture"}, {"$ref": "#/$defs/pendingFixture"}]}
        }
    },
    "$defs": {
        "point": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 2,
            "maxItems": 2
        },
        "generatedProvenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "description"],
            "properties": {
                "kind": {"const": "generated-in-repository"},
                "description": {"type": "string", "minLength": 1}
            }
        },
        "externalLicensedProvenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "description", "sourceUrl", "creator", "license", "attribution", "review", "privacy"],
            "properties": {
                "kind": {"const": "external-licensed"},
                "description": {"type": "string", "minLength": 1},
                "sourceUrl": {"type": "string", "pattern": "^https://"},
                "creator": {"type": "string", "minLength": 1},
                "license": {"type": "string", "minLength": 1},
                "attribution": {"type": "string", "minLength": 1},
                "review": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["reviewedBy", "reviewedAt"],
                    "properties": {
                        "reviewedBy": {"type": "string", "minLength": 1},
                        "reviewedAt": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
                    }
                },
                "privacy": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["containsPersonalData", "notes"],
                    "properties": {
                        "containsPersonalData": {"type": "boolean"},
                        "notes": {"type": "string", "minLength": 1}
                    }
                }
            }
        },
        "provenance": {
            "oneOf": [
                {"$ref": "#/$defs/generatedProvenance"},
                {"$ref": "#/$defs/externalLicensedProvenance"}
            ]
        },
        "expectedLine": {
            "type": "object",
            "additionalProperties": false,
            "required": ["order", "text", "polygon", "writingMode", "characterHitPoints"],
            "properties": {
                "order": {"type": "integer", "minimum": 0},
                "text": {"type": "string", "minLength": 1},
                "polygon": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/point"}},
                "writingMode": {"enum": ["horizontal-tb", "vertical-rl", "vertical-lr"]},
                "characterHitPoints": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["character", "index", "point"],
                        "properties": {
                            "character": {"type": "string", "minLength": 1},
                            "index": {"type": "integer", "minimum": 0},
                            "point": {"$ref": "#/$defs/point"}
                        }
                    }
                }
            }
        },
        "lookupTarget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lineOrder", "point", "expectedTerm"],
            "properties": {
                "lineOrder": {"type": "integer", "minimum": 0},
                "point": {"$ref": "#/$defs/point"},
                "expectedTerm": {"type": "string", "minLength": 1},
                "reading": {"type": "string", "minLength": 1},
                "dictionaryTerm": {"type": "string", "minLength": 1}
            }
        },
        "frameCase": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "embedding", "coordinateSpace"],
            "properties": {
                "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
                "embedding": {"enum": ["top", "same-origin-iframe", "cross-origin-iframe"]},
                "coordinateSpace": {"enum": ["frame-viewport", "top-viewport"]}
            }
        },
        "readyFixture": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "category", "file", "sha256", "dimensions", "license", "provenance", "expectedLines", "lookupTargets", "frameCase"],
            "properties": {
                "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
                "status": {"const": "ready"},
                "category": {"enum": ["synthetic-horizontal", "synthetic-vertical", "isolated-kanji", "mixed-text", "no-text"]},
                "file": {"type": "string", "pattern": "^fixtures/[a-z0-9-]+\\.svg$"},
                "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "dimensions": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["width", "height"],
                    "properties": {
                        "width": {"type": "integer", "minimum": 1},
                        "height": {"type": "integer", "minimum": 1}
                    }
                },
                "license": {"const": "CC0-1.0"},
                "provenance": {"$ref": "#/$defs/provenance"},
                "expectedLines": {"type": "array", "items": {"$ref": "#/$defs/expectedLine"}},
                "lookupTargets": {"type": "array", "items": {"$ref": "#/$defs/lookupTarget"}},
                "frameCase": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/frameCase"}]}
            }
        },
        "pendingFixture": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "category", "reason"],
            "properties": {
                "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
                "status": {"const": "pending"},
                "category": {"enum": ["natural-photo", "manga-game"]},
                "reason": {"type": "string", "minLength": 1}
            }
        }
    }
}
